# Solana Network Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# For better performance, use a dedicated RPC provider:
# SOLANA_RPC_URL=https://rpc.helius.xyz/?api-key=YOUR_API_KEY
# SOLANA_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Wallet Configuration
WALLET_1_ADDRESS=YOUR_WALLET_PUBLIC_KEY_HERE
WALLET_1_KEY_PATH=secrets/primary.json

WALLET_2_ADDRESS=YOUR_SECOND_WALLET_PUBLIC_KEY_HERE
WALLET_2_KEY_PATH=secrets/treasury.json

# Telegram Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# Discord Notifications
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./optimizer.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/optimizer
